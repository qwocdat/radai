export default async function handler(req, res) {
    // Chỉ chấp nhận POST
    if (req.method !== 'POST') {
        return res.status(405).json({
            error: 'Method Not Allowed'
        });
    }

    const GEMINI_API_KEY = process.env.GEMINI_API_KEY;

    if (!GEMINI_API_KEY) {
        return res.status(500).json({
            error: 'Chưa cấu hình GEMINI_API_KEY trên Vercel.'
        });
    }

    try {
        const { parts } = req.body || {};

        if (!Array.isArray(parts) || parts.length === 0) {
            return res.status(400).json({
                error: 'Dữ liệu ảnh gửi lên không hợp lệ.'
            });
        }

        // Gemini 3.6 Flash
        const GEMINI_URL =
            `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=${GEMINI_API_KEY}`;

        const response = await fetch(GEMINI_URL, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                contents: [
                    {
                        parts: parts
                    }
                ],
                generationConfig: {
                    responseMimeType: 'application/json'
                }
            })
        });

        // Đọc dạng text trước để tránh lỗi:
        // Unexpected token 'T' ... is not valid JSON
        const rawResponse = await response.text();

        let data;

        try {
            data = JSON.parse(rawResponse);
        } catch {
            console.error('Gemini trả về dữ liệu không phải JSON:', rawResponse);

            return res.status(502).json({
                error: 'Gemini API không trả về JSON hợp lệ.',
                details: rawResponse.substring(0, 500)
            });
        }

        // Google trả lỗi HTTP
        if (!response.ok) {
            console.error('Gemini API Error:', data);

            return res.status(response.status).json({
                error:
                    data?.error?.message ||
                    'Lỗi từ Gemini API.',
                details: data?.error || null
            });
        }

        // Trả nguyên response Gemini về frontend
        return res.status(200).json(data);

    } catch (error) {
        console.error('Lỗi tại Proxy Backend:', error);

        return res.status(500).json({
            error: 'Lỗi xử lý Serverless Function.',
            details: error.message
        });
    }
}
